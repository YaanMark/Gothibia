MainWindow
  id: adminDebugWindow
  !text: tr('Admin Debug')
  size: 1460 780
  @onEscape: modules.game_admindebug.hide()

  Label
    id: lblMe
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 0
    margin-left: 0
    width: 430
    height: 16
    text: Para Mim
    font: verdana-11px-antialised
    color: #9d9d9d
    text-align: center

  Label
    id: lblAdmin
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 0
    margin-left: 450
    width: 430
    height: 16
    text: Admin
    font: verdana-11px-antialised
    color: #9d9d9d
    text-align: center

  Label
    id: lblPlayer
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 0
    margin-left: 900
    width: 530
    height: 16
    text: Para Jogador
    font: verdana-11px-antialised
    color: #9d9d9d
    text-align: center

